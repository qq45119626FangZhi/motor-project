<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="12dp">

        <!-- MQTT连接区域 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接设置"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="地址"/>
            <EditText
                android:id="@+id/etHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="192.168.191.1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="端口"/>
            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1883"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="8dp">
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="连接"/>
            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="断开"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvConnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未连接"
            android:textColor="#D92121"
            android:textSize="18sp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#cccccc" android:layout_marginVertical="12dp"/>

        <!-- 电机控制区域 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="丝杆步进电机控制"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="前进距离(mm)"/>
            <EditText
                android:id="@+id/etDist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_margin="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最大速度(sps)"/>
            <EditText
                android:id="@+id/etSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRunDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已行进距离：0 mm"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvMotorState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前状态：未启动"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnStartMotor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启动电机"/>

    </LinearLayout>
</ScrollView>